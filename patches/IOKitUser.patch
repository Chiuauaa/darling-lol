+ You should have received a copy of the GNU General Public License
+ along with Darling.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+#ifndef IOKITUSER_KEXT_HWTRACE_H
+#define IOKITUSER_KEXT_HWTRACE_H
+
+/*
+ * darling-lol H1 (client side): passive trace of the kext/kextd queries that
+ * never reach iokitd.  Same /tmp/darling-hw-trace gate as the server and the
+ * sysctl shim, checked once per process with access(); it only reports what the
+ * call returned and never changes a result.  With the flag absent the cost is
+ * the one cached access().
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <unistd.h>
+
+#define DARLING_HW_TRACE_FLAG "/tmp/darling-hw-trace"
+#define DARLING_HW_TRACE_LOG  "/tmp/darling-hw-trace.log"
+
+static inline int darling_hw_trace_enabled(void)
+{
+	static int state = -1;
+
+	if (state < 0)
+		state = (access(DARLING_HW_TRACE_FLAG, 0) == 0);
+	return state;
+}
+
+static inline void darling_hw_trace(const char* format, ...)
+{
+	FILE* file;
+	va_list args;
+
+	if (!darling_hw_trace_enabled())
+		return;
+
+	file = fopen(DARLING_HW_TRACE_LOG, "a");
+	if (!file)
+		return;
+
+	fprintf(file, "H1IOKIT caller=%d ", (int) getpid());
+	va_start(args, format);
+	vfprintf(file, format, args);
+	va_end(args);
+	fputc('\n', file);
+
+	fclose(file);
+}
+
+#endif // IOKITUSER_KEXT_HWTRACE_H

